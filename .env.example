# Copy to .env for local development, then replace every placeholder. Do not commit a real .env file.
# CloudType Configure uses the same variable names as Secrets.
APP_ENV=development
# CloudType MongoDB public connection address. The username and password stay in local .env or CloudType Secrets.
MONGODB_HOST=svc.sel3.cloudtype.app
MONGODB_PORT=32075
MONGODB_USERNAME=admin
MONGODB_PASSWORD=replace-with-cloudtype-mongodb-admin-password
DATABASE_NAME=ai_us_development
FRONTEND_ORIGINS=https://<frontend-development-domain>
# Use a randomly generated secret of at least 32 bytes.
JWT_SECRET=replace-with-a-random-secret-that-is-at-least-32-bytes
JWT_EXPIRATION_MINUTES=60
# Participant surveys can span both parts; keep this longer than a complete session.
PARTICIPANT_JWT_EXPIRATION_MINUTES=240
RESEARCHER_BOOTSTRAP_USERNAME=replace-before-first-deployment
RESEARCHER_BOOTSTRAP_PASSWORD=replace-before-first-deployment
# Required only for researcher-triggered parsing of screenshot submissions.
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_SCREENSHOT_MODEL=gemini-3.8-flash
# One dedicated Gmail sender account. Enable Google 2-Step Verification and use an app password.
EMAIL_PROVIDER=gmail_smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=project-sender@gmail.com
SMTP_APP_PASSWORD=replace-with-gmail-app-password
EMAIL_FROM=project-sender@gmail.com
PASSWORD_RESET_BASE_URL=https://<frontend-development-domain>/index.html