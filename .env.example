# CloudType Configure panel Secret names. Do not commit a real .env file.
APP_ENV=development
MONGODB_URI=mongodb://<cloudtype-mongodb-host>:27017
DATABASE_NAME=ai_us_development
FRONTEND_ORIGINS=https://<frontend-development-domain>
# Use a randomly generated secret of at least 32 bytes.
JWT_SECRET=replace-with-a-random-secret-that-is-at-least-32-bytes
JWT_EXPIRATION_MINUTES=60
RESEARCHER_BOOTSTRAP_USERNAME=replace-before-first-deployment
RESEARCHER_BOOTSTRAP_PASSWORD=replace-before-first-deployment
# One dedicated Gmail sender account. Enable Google 2-Step Verification and use an app password.
EMAIL_PROVIDER=gmail_smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=project-sender@gmail.com
SMTP_APP_PASSWORD=replace-with-gmail-app-password
EMAIL_FROM=project-sender@gmail.com
PASSWORD_RESET_BASE_URL=https://<frontend-development-domain>/index.html