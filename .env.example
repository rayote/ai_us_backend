# CloudType Configure panel Secret names. Do not commit a real .env file.
APP_ENV=development
MONGODB_URI=mongodb://<cloudtype-mongodb-host>:27017
DATABASE_NAME=ai_us_development
FRONTEND_ORIGINS=https://<frontend-development-domain>
# Use a randomly generated secret of at least 32 bytes.
JWT_SECRET=replace-with-a-random-secret-that-is-at-least-32-bytes
JWT_EXPIRATION_MINUTES=60